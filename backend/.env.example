# Copiá este archivo como .env y completá con tus datos de EmailJS.
# En EmailJS: Account > Security > activar "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Dominios del frontend que pueden usar la API, separados por coma.
FRONTEND_ORIGIN=http://localhost:5173

PORT=3001
